# Rename this file to .env and fill in your real values

# Flask
SECRET_KEY=change-this-to-a-random-secret-string
FLASK_DEBUG=1

# Groq (get free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Webhook — your voice recorder (ASR) app POSTs audio here directly:
#   POST /api/webhook/voice-observation
#   headers: X-Webhook-Key: <this value>
#   form-data: audio=<file>, username=<optional, matches an existing account>,
#              reporter_name=<optional, used if the audio doesn't state a name>
# Leave blank to disable the check (not recommended once you deploy live).
WEBHOOK_API_KEY=set-a-long-random-string-here

# Google Drive (optional - app works without it, just stores audio locally)
# 1. Go to console.cloud.google.com -> create project -> enable Google Drive API
# 2. Create a Service Account -> create JSON key -> save as service_account.json in this folder
# 3. Create a folder in Google Drive -> share it with the service account's email (Editor access)
# 4. Copy that folder's ID from its URL and paste below
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
